# Copy this file to .env and fill in real values
# NEVER commit .env to version control

# Environment: "development" | "production" | "test"
# Controls DB TLS behaviour — see src/db.js for details
NODE_ENV=development

# Microsoft SQL Server connection
DB_HOST=your-db-host.example.com
DB_PORT=1433
DB_USER=your_db_user
DB_PASSWORD=your_strong_password_here
DB_NAME=billing_db

# JWT secrets — generate each with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# These MUST be different from each other and at least 32 characters
JWT_ACCESS_SECRET=replace_with_64_char_hex_secret
JWT_REFRESH_SECRET=replace_with_different_64_char_hex_secret

# Optional: path to a CA certificate file for verifying the SQL Server TLS cert.
# Only needed in production when the server uses a private/self-signed CA.
# Leave unset to use Node's built-in public CA store (e.g. Let's Encrypt, DigiCert).
# DB_SSL_CA=/etc/ssl/certs/my-sqlserver-ca.pem

# Server port
PORT=3000

# Comma-separated exact origins allowed by CORS — NO wildcards.
# Flutter mobile apps send no Origin and are always allowed through.
# Examples:
#   Dev:  http://localhost:8080,http://localhost:3000
#   Prod: https://billing.yourdomain.com
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Rate limiting (requests per window per IP)
# Login: 5 attempts / 15 min | Register: 3 / hour | Refresh: 20 / 15 min | Global: 200 / 15 min
# Account lockout: 10 consecutive PIN failures → locked 15 min (hardcoded in routes/auth.js)

# ── WhatsApp OTP (SMSala) ────────────────────────────────────────────────────
# Set WHATSAPP_ENABLED=true to activate real delivery.
# When false, OTPs are still generated and stored in DB but not sent via WhatsApp.
# In development the OTP is returned in the API response as dev_otp for easy testing.
#
# Get your API token and template ID from https://smsala.com
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=REPLACE_WITH_SMSALA_API_TOKEN
WHATSAPP_TPL_OTP=REPLACE_WITH_OTP_TEMPLATE_ID
# Bill receipt template — variables: {1}=shop_name {2}=bill_no {3}=date {4}=item_list {5}=total {6}=pay_mode
WHATSAPP_TPL_BILL=REPLACE_WITH_BILL_TEMPLATE_ID
