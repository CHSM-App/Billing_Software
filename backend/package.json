{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/migrate.js",
    "migrate:up": "node src/migrate.js up",
    "migrate:down": "node src/migrate.js down",
    "migrate:status": "node src/migrate.js status",
    "db:init": "node src/init-db.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/routes/**/*.js",
      "src/auth.js",
      "src/middleware/**/*.js",
      "!src/migrate.js",
      "!src/init-db.js"
    ],
    "coverageThreshold": {
      "global": { "lines": 25, "functions": 15, "branches": 15 }
    },
    "coverageReporters": ["text", "lcov", "html"],
    "setupFiles": ["./tests/setup.js"]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.5.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-roll": "^4.0.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  }
}
