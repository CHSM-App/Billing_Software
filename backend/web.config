<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <httpErrors existingResponse="PassThrough"/>

    <httpProtocol>
      <customHeaders>
        <add name="Connection" value="keep-alive"/>
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <verbs>
          <add verb="OPTIONS" allowed="true"/>
        </verbs>
      </requestFiltering>
    </security>

    <tracing>
      <traceFailedRequests>
        <clear/>
      </traceFailedRequests>
    </tracing>

    <staticContent>
      <!-- Serve Vite-generated assets with long cache headers -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00"/>
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json"/>
    </staticContent>

    <handlers>
      <add name="iisnode" path="src/server.js" verb="*" modules="iisnode"/>
    </handlers>

    <rewrite>
      <rules>
        <!-- 1. iisnode debug inspector — leave untouched -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^src/server\.js\/debug[\/]?"/>
        </rule>

        <!-- 2. OPTIONS preflight — always to Node (CORS headers live there) -->
        <rule name="OPTIONS preflight" stopProcessing="true">
          <match url="(.*)"/>
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^OPTIONS$"/>
          </conditions>
          <action type="Rewrite" url="src/server.js"/>
        </rule>

        <!-- 3. Static assets in public/ — let IIS serve them directly.
             Match /assets/* and /downloads/* unconditionally and rewrite to
             public/ so IIS serves them without going through Node. -->
        <rule name="Static assets" stopProcessing="true">
          <match url="^(assets|downloads)/(.*)"/>
          <action type="Rewrite" url="public/{R:0}"/>
        </rule>

        <!-- 4. Root index.html — serve directly from public/index.html -->
        <rule name="Root index.html" stopProcessing="true">
          <match url="^$"/>
          <action type="Rewrite" url="public/index.html"/>
        </rule>

        <!-- 5. Root-level static files (favicon.ico, robots.txt, manifest, etc.)
             are also emitted into backend/public/, not the backend root. -->
        <rule name="Root static files" stopProcessing="true">
          <match url="^[^/]+\.[a-zA-Z0-9]+$"/>
          <conditions>
            <add input="{APPL_PHYSICAL_PATH}public\{R:0}" matchType="IsFile"/>
          </conditions>
          <action type="Rewrite" url="public/{R:0}"/>
        </rule>

        <!-- 6. All API, receipt, and health routes → Node -->
        <rule name="Node.js API" stopProcessing="true">
          <match url="^(api|receipt|health)(/.*)?$"/>
          <action type="Rewrite" url="src/server.js"/>
        </rule>

        <!-- 7. Everything else (React Router client-side routes) → Node,
             which returns index.html for the SPA to handle -->
        <rule name="React SPA" stopProcessing="true">
          <match url="(.*)"/>
          <action type="Rewrite" url="src/server.js"/>
        </rule>
      </rules>
    </rewrite>

    <iisnode
      devErrorsEnabled="true"
      debuggingEnabled="false"
      loggingEnabled="true"
      logDirectory="iisnode_logs"
      maxLogFileSizeInKB="10240"
      maxTotalLogFileSizeInKB="102400"
      maxLogFiles="20"
      nodeProcessCommandLine="C:\Program Files\nodejs\node.exe"
      nodeProcessCountPerApplication="1"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="200"
      namedPipeConnectionRetryDelay="250"
      maxNamedPipeConnectionPoolSize="512"
      maxNamedPipePooledConnectionAge="60000"
      asyncCompletionThreadCount="0"
      initialRequestBufferSize="4096"
      maxRequestBufferSize="65536"
      watchedFiles="*.js;node_modules\*"
      recycleSignalEnabled="false"
    />

    <directoryBrowse enabled="false"/>
  </system.webServer>

  <system.web>
    <compilation tempDirectory="C:\Inetpub\vhosts\vengurlatech.com\tmp"/>
  </system.web>
</configuration>
