# Environment variables — NEVER commit these
.env
.env.*
!.env.example

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/
# Landing page build — generated by CI into backend/public/, not committed to main
backend/public/
# SSR bundle used only to prerender the landing page at build time
landingPage/.ssr/

# OS
.DS_Store
Thumbs.db
  
# Editor
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Deploy — service account key must never be committed
deploy/service-account.json
deploy/node_modules/

# Flutter/Dart
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/build/
frontend/*.g.dart
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/key.properties
frontend/android/app/google-services.json
frontend/ios/Runner/GoogleService-Info.plist

# Downloaded by windows-release.yml before compiling installer.iss — not
# committed, CI fetches the current one from Microsoft on every release build.
frontend/windows/vc_redist.x64.exe
